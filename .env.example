# Trigger.dev secret key for the DEV environment.
# Get it at: cloud.trigger.dev → your project → API Keys → "Development" secret key (starts with tr_dev_)
TRIGGER_SECRET_KEY=

# ─── YouTube Data API v3 (video title, channel, views, duration) ───────────────
# console.cloud.google.com → create/select a project → APIs & Services → Library →
# enable "YouTube Data API v3" → Credentials → Create credentials → API key
YOUTUBE_API_KEY=

# ─── Google Gemini (AI summary, takeaways, action items) — free tier ───────────
# aistudio.google.com → Get API key → Create API key (no credit card needed)
GEMINI_API_KEY=
# Which Gemini model to use. "gemini-flash-latest" always points to Google's current free-tier Flash model.
GEMINI_MODEL=

# ─── Google Sheets (where each analysis is saved) — via a Service Account ─────
# Same Google Cloud project → APIs & Services → Library → enable "Google Sheets API".
# Then IAM & Admin → Service Accounts → Create service account → open it → Keys →
# Add key → JSON. From the downloaded JSON file copy:
#   "client_email" → GOOGLE_SERVICE_ACCOUNT_EMAIL
#   "private_key"  → GOOGLE_PRIVATE_KEY (keep the quotes and the \n characters exactly as in the file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The long ID in your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# IMPORTANT: click Share on the sheet and add GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SHEET_ID=
# The name of the tab (bottom of the sheet) to write rows into. Must already exist.
GOOGLE_SHEET_TAB=

# ─── Gmail (sends the report email) ──────────────────────────────────────────
# Your Gmail address that sends the reports
GMAIL_USER=
# myaccount.google.com → Security → turn on 2-Step Verification →
# then search "App passwords" → create one named "YouTube Analysis" → paste the 16 characters
GMAIL_APP_PASSWORD=
# Default address that receives reports (a run can override it with "recipientEmail")
REPORT_RECIPIENT_EMAIL=
